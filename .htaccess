# Version compatible hébergement mutualisé

# Bloquer l'accès aux dossiers sensibles (si mod_rewrite disponible)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(database|logs|migrations|classes|config)/ - [F,L]
</IfModule>

# Empêcher le listing des répertoires
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Protection des fichiers SQLite (Apache 2.4 et 2.2)
<FilesMatch "\.(sqlite|db)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protection des fichiers de log
<FilesMatch "\.(log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
